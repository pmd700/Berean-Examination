{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BEX",
  "version": "2.0.1",
  "identifier": "org.bereanexamination.bex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": [
      "../attached_assets/bibles/*.json",
      "../attached_assets/lsv_1775867344760.txt"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNTIyRkVFMzk4NkI3OEYKUldTUHQ0WTU3aTlTb2owaFRTdDNoeTVFMnlRU0RaMXFkbWpSaVhMOTg2c0R5SXlTdnFXNUtrakoK",
      "endpoints": [
        "https://github.com/pmd700/Berean-Examination/releases/latest/download/latest.json"
      ]
    }
  }
}
